@page
@model Master_Feed_Agency.Pages.Customers.CreateModel
@{
    ViewData["Title"] = "Customer Add Karein";
}

<div class="customer-page customer-form-page customer-page--create">
    <section class="customer-page-header customer-form-header">
        <div class="customer-page-heading">
            <span class="customer-page-kicker">Customers</span>
            <h1>Customer Add Karein</h1>
            <p>Sirf zaroori customer details enter karein. Purana udhaar ho to opening balance mein likhein.</p>
        </div>
        <div class="customer-page-actions">
            <a data-return-list="/Customers" asp-page="Index" class="btn btn-light customer-header-btn">Customers</a>
        </div>
    </section>

    <form method="post" class="customer-form-layout customer-form-layout--simple">
        <div class="customer-form-main">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger customer-form-alert"></div>

            <section class="customer-panel customer-form-panel customer-form-panel--basic">
                <div class="customer-panel-header">
                    <div><span class="customer-section-kicker">Basic details</span><h2>Customer information</h2><p>Name, phone aur area se customer jaldi mil jayega.</p></div>
                </div>
                <div class="customer-panel-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. Ahmed Ali" />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.BusinessName" class="form-label"></label>
                            <input asp-for="Input.BusinessName" class="form-control" placeholder="Optional shop / business name" />
                            <span asp-validation-for="Input.BusinessName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Phone" class="form-label"></label>
                            <input asp-for="Input.Phone" class="form-control" placeholder="03xx xxxxxxx" />
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Area" class="form-label"></label>
                            <input asp-for="Input.Area" class="form-control" placeholder="Village / city / area" />
                            <span asp-validation-for="Input.Area" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Address" class="form-label"></label>
                            <textarea asp-for="Input.Address" class="form-control" rows="2" placeholder="Address (optional)"></textarea>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="customer-panel customer-form-panel customer-form-panel--credit">
                <div class="customer-panel-header">
                    <div><span class="customer-section-kicker">Khata setup</span><h2>Udhaar settings</h2><p>New customer ho to opening balance 0 rakhein.</p></div>
                </div>
                <div class="customer-panel-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Input.OpeningBalance" class="form-label"></label>
                            <div class="input-group"><span class="input-group-text">Rs.</span><input asp-for="Input.OpeningBalance" class="form-control" /></div>
                            <span asp-validation-for="Input.OpeningBalance" class="text-danger"></span>
                            <div class="form-text">Purana baqaya ho to yahan likhein, warna 0.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.CreditLimit" class="form-label"></label>
                            <div class="input-group"><span class="input-group-text">Rs.</span><input asp-for="Input.CreditLimit" class="form-control" /></div>
                            <span asp-validation-for="Input.CreditLimit" class="text-danger"></span>
                            <div class="form-text">Limit use nahi karni to 0 rehne dein.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.DefaultCreditDays" class="form-label"></label>
                            <div class="input-group"><input asp-for="Input.DefaultCreditDays" class="form-control" /><span class="input-group-text">days</span></div>
                            <span asp-validation-for="Input.DefaultCreditDays" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Notes" class="form-label"></label>
                            <textarea asp-for="Input.Notes" class="form-control" rows="2" placeholder="Optional note"></textarea>
                        </div>
                    </div>
                </div>
            </section>

            <div class="customer-form-actions">
                <a data-return-list="/Customers" asp-page="Index" class="btn btn-light">Wapas Jayein</a>
                <button type="submit" class="btn btn-primary">Save Customer</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
