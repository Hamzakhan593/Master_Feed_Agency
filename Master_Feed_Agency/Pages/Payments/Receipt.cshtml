@page "{id:long}"
@model Master_Feed_Agency.Pages.Payments.ReceiptModel
@using Master_Feed_Agency.Models
@{
    Layout = null;
    var isPosted = Model.Payment.Status == PaymentStatus.Posted;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Payment Receipt @Model.Payment.ReceiptNo</title>
    <style>
        :root { color-scheme: light; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 32px 18px; color: #252e27; background: #dfe3d9; font-family: Arial, Helvetica, sans-serif; }
        .receipt-shell { max-width: 760px; margin: 0 auto; }
        .receipt-actions { margin-bottom: 14px; display: flex; justify-content: flex-end; gap: 8px; }
        .receipt-actions button, .receipt-actions a { min-height: 38px; padding: 9px 14px; border-radius: 8px; border: 1px solid #d4d5c6; color: #344054; background: #fff; font: inherit; font-size: 13px; font-weight: 700; text-decoration: none; cursor: pointer; }
        .receipt-actions .primary { color: #fff; border-color: #226348; background: #226348; }
        .receipt { overflow: hidden; border: 1px solid #d4d5c6; border-radius: 16px; background: #fff; box-shadow: 0 14px 34px rgba(16,24,40,.08); }
        .receipt-head { padding: 26px 28px 22px; display: flex; justify-content: space-between; gap: 24px; border-bottom: 1px solid #e1e1d4; }
        .brand { display: flex; align-items: center; gap: 12px; }
        .brand-mark { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; color: #fff; background: #226348; font-size: 13px; font-weight: 800; }
        .brand h1 { margin: 0; font-size: 18px; letter-spacing: -.02em; }
        .brand p { margin: 4px 0 0; color: #667085; font-size: 12px; }
        .receipt-meta { text-align: right; }
        .receipt-meta span { display: block; color: #98a2b3; font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
        .receipt-meta strong { display: block; margin-top: 4px; font-size: 14px; }
        .receipt-meta small { display: block; margin-top: 5px; color: #667085; font-size: 11px; }
        .amount-band { padding: 25px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; background: #f8fafc; border-bottom: 1px solid #e1e1d4; }
        .amount-band > div:first-child span { color: #667085; font-size: 12px; font-weight: 700; }
        .amount { margin-top: 4px; color: #101828; font-size: 34px; font-weight: 800; letter-spacing: -.04em; }
        .status { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; }
        .status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; }
        .status.posted { color: #067647; background: #ecfdf3; }
        .status.posted::before { background: #12b76a; }
        .status.reversed { color: #475467; background: #f2f4f7; }
        .status.reversed::before { background: #98a2b3; }
        .receipt-body { padding: 24px 28px 28px; }
        .customer-card { padding: 15px 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border: 1px solid #e7ebf1; border-radius: 11px; }
        .customer-card span, .detail span { display: block; color: #98a2b3; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
        .customer-card strong { display: block; margin-top: 4px; font-size: 15px; }
        .customer-card small { display: block; margin-top: 4px; color: #667085; font-size: 12px; }
        .details { margin-top: 18px; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); border: 1px solid #e7ebf1; border-radius: 11px; overflow: hidden; }
        .detail { padding: 14px 15px; border-bottom: 1px solid #edf0f4; }
        .detail:nth-child(odd) { border-right: 1px solid #edf0f4; }
        .detail:nth-last-child(-n+2) { border-bottom: 0; }
        .detail strong { display: block; margin-top: 5px; font-size: 13px; }
        .notes { margin-top: 18px; padding: 14px 16px; border-left: 3px solid #226348; border-radius: 0 9px 9px 0; background: #eaf3ec; }
        .notes span { color: #19563e; font-size: 10px; font-weight: 800; text-transform: uppercase; }
        .notes p { margin: 6px 0 0; color: #344054; font-size: 12px; line-height: 1.55; }
        .receipt-foot { padding: 16px 28px 19px; display: flex; justify-content: space-between; gap: 16px; border-top: 1px dashed #d4d5c6; color: #98a2b3; font-size: 10px; }
        @@media (max-width: 600px) {
            body { padding: 12px; }
            .receipt-head, .amount-band { padding-inline: 18px; }
            .receipt-body { padding: 18px; }
            .receipt-head { flex-direction: column; }
            .receipt-meta { text-align: left; }
            .amount-band { align-items: flex-start; flex-direction: column; }
            .amount { font-size: 29px; }
            .details { grid-template-columns: 1fr; }
            .detail:nth-child(odd) { border-right: 0; }
            .detail:nth-last-child(2) { border-bottom: 1px solid #edf0f4; }
            .receipt-foot { padding-inline: 18px; flex-direction: column; }
        }
        @@media print {
            @@page { margin: 12mm; }
            body { padding: 0; background: #fff; }
            .receipt-actions { display: none !important; }
            .receipt { border-color: #d7dce4; box-shadow: none; }
            .receipt-shell { max-width: none; }
        }
    </style>
</head>
<body>
    <main class="receipt-shell">
        <div class="receipt-actions">
            <a href="/Payments/Details/@Model.Payment.Id">Back to details</a>
            <button class="primary" type="button" onclick="window.print()">Print / Save PDF</button>
        </div>

        <article class="receipt">
            <header class="receipt-head">
                <div class="brand">
                    <span class="brand-mark">MF</span>
                    <div><h1>Master Feed Agency</h1><p>Official Payment Receipt</p></div>
                </div>
                <div class="receipt-meta">
                    <span>Receipt Number</span>
                    <strong>@Model.Payment.ReceiptNo</strong>
                    <small>@BusinessTime.ToLocal(Model.Payment.PaymentDate).ToString("dd MMM yyyy · hh:mm tt")</small>
                </div>
            </header>

            <section class="amount-band">
                <div><span>Amount Received</span><div class="amount">Rs. @Model.Payment.Amount.ToString("N2")</div></div>
                <span class="status @(isPosted ? "posted" : "reversed")">@(isPosted ? "Saved" : "Cancelled")</span>
            </section>

            <section class="receipt-body">
                <div class="customer-card">
                    <div><span>Received from</span><strong>@Model.Payment.Customer.Name</strong><small>@Model.Payment.Customer.Phone</small></div>
                    <div style="text-align:right"><span>Customer ID</span><strong>#@Model.Payment.CustomerId</strong></div>
                </div>

                <div class="details">
                    <div class="detail"><span>Payment method</span><strong>@Model.Payment.Method</strong></div>
                    <div class="detail"><span>Payment date</span><strong>@BusinessTime.ToLocal(Model.Payment.PaymentDate).ToString("dd MMM yyyy")</strong></div>
                    <div class="detail"><span>Payment time</span><strong>@BusinessTime.ToLocal(Model.Payment.PaymentDate).ToString("hh:mm tt")</strong></div>
                    <div class="detail"><span>Receipt Status</span><strong>@(isPosted ? "Saved" : "Cancelled")</strong></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Payment.Notes))
                {
                    <div class="notes"><span>Notes</span><p>@Model.Payment.Notes</p></div>
                }
            </section>

            <footer class="receipt-foot">
                <span>Computer se bani rasheed. Zarurat par is number se payment check ki ja sakti hai.</span>
                <span>Master Feed Agency Management System</span>
            </footer>
        </article>
    </main>
</body>
</html>
