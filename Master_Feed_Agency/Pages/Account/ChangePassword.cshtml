@page
@model Master_Feed_Agency.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="authx-account-page">
    <section class="authx-account-hero">
        <div>
            <span class="authx-eyebrow">Account security</span>
            <h1>Change password</h1>
            <p>Update your private password without changing your role, permissions or business data.</p>
        </div>
        <div class="authx-account-shield">✓</div>
    </section>

    <div class="authx-account-grid">
        <section class="authx-account-card">
            @if (Model.MustChangePassword)
            {
                <div class="authx-alert authx-alert-info">
                    <span>!</span>
                    <div><strong>Password update required</strong><p>The Owner reset your password. Set a new private password before continuing.</p></div>
                </div>
            }

            <div class="authx-section-heading">
                <span>Credentials</span>
                <h2>Set a new password</h2>
                <p>Enter your current password, then choose and confirm the new one.</p>
            </div>

            <form method="post" class="authx-form">
                <div asp-validation-summary="ModelOnly" class="authx-validation"></div>

                <div class="authx-field">
                    <label asp-for="Input.CurrentPassword" class="form-label"></label>
                    <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Current password" />
                    <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="authx-field">
                    <label asp-for="Input.NewPassword" class="form-label"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="New private password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <div class="authx-field">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat new password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="authx-form-actions">
                    <a asp-page="/Index" class="btn btn-outline-secondary">Wapas Jayein</a>
                    <button type="submit" class="btn btn-primary">Update password</button>
                </div>
            </form>
        </section>

        <aside class="authx-security-side">
            <div class="authx-security-card">
                <span class="authx-side-kicker">Password standard</span>
                <h3>Use a strong private password</h3>
                <div class="authx-requirements">
                    <div><span>8+</span><p>At least 8 characters</p></div>
                    <div><span>Aa</span><p>Uppercase and lowercase letters</p></div>
                    <div><span>123</span><p>At least one number</p></div>
                    <div><span>#!</span><p>At least one symbol</p></div>
                </div>
            </div>
            <div class="authx-security-card authx-security-card-soft">
                <span class="authx-side-kicker">Good practice</span>
                <h3>Keep the account personal</h3>
                <p>Apna password kisi se share na karein. Har staff member apna account use kare.</p>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
