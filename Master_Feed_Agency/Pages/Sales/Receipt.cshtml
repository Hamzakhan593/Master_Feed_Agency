@page "{id:long}"
@model Master_Feed_Agency.Pages.Sales.ReceiptModel
@{
    Layout = null;
    var customerName = Model.Sale.Customer?.Name ?? "Walk-in Customer";
    var saleTypeText = Model.Sale.SaleType == SaleType.Cash ? "Cash Sale" : Model.Sale.SaleType == SaleType.Credit ? "Udhaar Sale" : "Kuch Payment + Udhaar";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bill @Model.Sale.InvoiceNo - Master Feed Agency</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; color: #252e27; background: #dfe3d9; font-family: Inter, "Segoe UI", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
        .actions { max-width: 900px; margin: 18px auto 0; display: flex; justify-content: flex-end; gap: 8px; }
        .actions button { border: 1px solid #226348; border-radius: 9px; padding: 10px 17px; color: #fff; background: #226348; font: inherit; font-weight: 700; cursor: pointer; }
        .invoice { max-width: 900px; margin: 14px auto 36px; background: #fff; border: 1px solid #e5eaf2; border-radius: 16px; box-shadow: 0 16px 42px rgba(15, 23, 42, .09); overflow: hidden; }
        .invoice-head { padding: 30px 34px 26px; display: flex; justify-content: space-between; gap: 24px; color: #252e27; background: #e7efdf; }
        .brand-mark { width: 46px; height: 46px; margin-bottom: 14px; display: grid; place-items: center; border-radius: 12px; background: #226348; font-size: 13px; font-weight: 800; }
        .invoice-head h1 { margin: 0; font-size: 25px; letter-spacing: -.02em; }
        .invoice-head p { margin: 6px 0 0; color: #65736b; font-size: 13px; }
        .invoice-id { min-width: 240px; text-align: right; }
        .invoice-id small { display: block; color: #65736b; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
        .invoice-id strong { display: block; margin-top: 5px; font-size: 20px; letter-spacing: .02em; }
        .invoice-id time { display: block; margin-top: 6px; color: #65736b; font-size: 12px; }
        .status { margin-top: 12px; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 5px 10px; color: #226348; background: rgba(22, 163, 74, .16); font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
        .status:before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #4ade80; }
        .status.cancelled { color: #ac3f34; background: rgba(220, 38, 38, .16); }
        .status.cancelled:before { background: #f87171; }
        .invoice-body { padding: 30px 34px 34px; }
        .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 28px; }
        .meta-card { padding: 16px 18px; border: 1px solid #e5eaf2; border-radius: 12px; background: #fbfcfe; }
        .meta-card > small { display: block; margin-bottom: 8px; color: #8a98ac; font-size: 9px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
        .meta-card strong { display: block; color: #252e27; font-size: 14px; }
        .meta-card .muted { margin-top: 4px; color: #667085; font-size: 12px; line-height: 1.55; }
        .info-list { display: grid; gap: 7px; }
        .info-row { display: flex; justify-content: space-between; gap: 18px; font-size: 12px; }
        .info-row span { color: #7a8798; }
        .info-row strong { text-align: right; font-size: 12px; }
        table { width: 100%; border-collapse: collapse; }
        th { padding: 10px 12px; color: #667085; background: #f6f8fb; border-top: 1px solid #e5eaf2; border-bottom: 1px solid #e5eaf2; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-align: left; text-transform: uppercase; }
        td { padding: 14px 12px; border-bottom: 1px solid #eef1f5; font-size: 12px; vertical-align: top; }
        .product strong { display: block; font-size: 12px; }
        .product span { display: block; margin-top: 3px; color: #98a2b3; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; }
        .num { text-align: right; white-space: nowrap; }
        .totals-wrap { margin-top: 20px; display: flex; justify-content: flex-end; }
        .totals { width: min(100%, 370px); }
        .total-row { padding: 7px 0; display: flex; justify-content: space-between; gap: 15px; color: #667085; font-size: 12px; }
        .total-row strong { color: #344054; }
        .total-row.grand { margin-top: 5px; padding: 12px 0; border-top: 1px solid #dfe5ed; border-bottom: 1px solid #dfe5ed; color: #252e27; font-size: 16px; font-weight: 800; }
        .total-row.grand strong { color: #252e27; font-size: 18px; }
        .total-row.credit { margin-top: 5px; color: #b45309; font-weight: 700; }
        .total-row.credit strong { color: #b45309; }
        .note { margin-top: 24px; padding: 13px 15px; border: 1px solid #e5eaf2; border-radius: 10px; color: #667085; background: #fbfcfe; font-size: 11px; line-height: 1.55; }
        .note strong { color: #344054; }
        .cancel-box { margin-top: 18px; padding: 13px 15px; border: 1px solid #f5b7b1; border-radius: 10px; color: #b42318; background: #fef3f2; font-size: 11px; }
        .footer { margin-top: 28px; padding-top: 18px; display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid #e5eaf2; color: #98a2b3; font-size: 10px; line-height: 1.5; }
        @@media print {
            @@page { margin: 12mm; }
            body { background: #fff; }
            .actions { display: none; }
            .invoice { max-width: none; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
            .invoice-head { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
        @@media (max-width: 640px) {
            .actions { margin: 10px; }
            .invoice { margin: 10px; border-radius: 12px; }
            .invoice-head { padding: 24px 20px; flex-direction: column; }
            .invoice-id { min-width: 0; text-align: left; }
            .invoice-body { padding: 22px 20px 26px; }
            .meta-grid { grid-template-columns: 1fr; }
            th, td { padding-inline: 8px; }
            .footer { flex-direction: column; }
        }
    </style>
</head>
<body>
    <div class="actions"><button type="button" onclick="window.print()">Print / Save PDF</button></div>
    <main class="invoice">
        <header class="invoice-head">
            <div>
                <div class="brand-mark">MF</div>
                <h1>Master Feed Agency</h1>
                <p>Sales Bill / Receipt</p>
            </div>
            <div class="invoice-id">
                <small>Bill number</small>
                <strong>@Model.Sale.InvoiceNo</strong>
                <time>@BusinessTime.ToLocal(Model.Sale.SaleDate).ToString("dd MMM yyyy, hh:mm tt")</time>
                <span class="status @(Model.Sale.Status == SaleStatus.Cancelled ? "cancelled" : "")">@(Model.Sale.Status == SaleStatus.Cancelled ? "Cancelled" : "Saved")</span>
            </div>
        </header>

        <div class="invoice-body">
            <div class="meta-grid">
                <section class="meta-card">
                    <small>Customer</small>
                    <strong>@customerName</strong>
                    @if (Model.Sale.Customer is not null)
                    {
                        <div class="muted">@Model.Sale.Customer.Phone</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Sale.Customer.Address))
                        {
                            <div class="muted">@Model.Sale.Customer.Address</div>
                        }
                    }
                    else
                    {
                        <div class="muted">Cash walk-in customer</div>
                    }
                </section>
                <section class="meta-card">
                    <small>Payment details</small>
                    <div class="info-list">
                        <div class="info-row"><span>Sale type</span><strong>@saleTypeText</strong></div>
                        <div class="info-row"><span>Wasooli</span><strong>@(Model.Sale.InitialPaymentMethod?.ToString() ?? "—")</strong></div>
                        <div class="info-row"><span>Payment Date</span><strong>@(Model.Sale.DueDate?.ToString("dd MMM yyyy") ?? "—")</strong></div>
                        <div class="info-row"><span>Served by</span><strong>@Model.CreatedByName</strong></div>
                    </div>
                </section>
            </div>

            <table>
                <thead><tr><th>Product</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Sale.Items.OrderBy(x => x.Id))
                {
                    <tr>
                        <td class="product"><strong>@item.Product.Name</strong><span>@item.Product.Code</span></td>
                        <td class="num">@item.Quantity.ToString("0.###") @item.Product.Unit</td>
                        <td class="num">Rs. @item.Rate.ToString("N2")</td>
                        <td class="num"><strong>Rs. @item.LineTotal.ToString("N2")</strong></td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="totals-wrap">
                <div class="totals">
                    <div class="total-row"><span>Kul Raqam</span><strong>Rs. @Model.Sale.GrossTotal.ToString("N2")</strong></div>
                    <div class="total-row"><span>Discount</span><strong>Rs. @Model.Sale.Discount.ToString("N2")</strong></div>
                    <div class="total-row grand"><span>Final Raqam</span><strong>Rs. @Model.Sale.NetTotal.ToString("N2")</strong></div>
                    <div class="total-row"><span>Abhi Wasool Raqam</span><strong>Rs. @Model.Sale.PaidAtSale.ToString("N2")</strong></div>
                    <div class="total-row credit"><span>Baqi Udhaar</span><strong>Rs. @Model.Sale.CreditAmount.ToString("N2")</strong></div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Sale.Notes))
            {
                <div class="note"><strong>Note:</strong> @Model.Sale.Notes</div>
            }

            @if (Model.Sale.Status == SaleStatus.Cancelled)
            {
                <div class="cancel-box"><strong>Cancelled:</strong> @Model.Sale.CancelReason</div>
            }

            <footer class="footer">
                <span>Ye rasheed system record se bani hai. Printed copy kho jaye to bhi asli bill system mein rahega.</span>
                <span>Master Feed Agency</span>
            </footer>
        </div>
    </main>
</body>
</html>
