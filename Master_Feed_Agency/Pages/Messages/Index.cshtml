@page
@model Master_Feed_Agency.Pages.Messages.IndexModel
@using Master_Feed_Agency.Models
@using Master_Feed_Agency.Services
@{
    ViewData["Title"] = "WhatsApp Messages";
    var options = Model.Settings;
    var ownerTime = $"{Math.Clamp(options.DailyOwnerReportHour, 0, 23):00}:00";
    var dueTime = $"{Math.Clamp(options.DueReminderHour, 0, 23):00}:00";
    var waitingCount = Model.ReminderSchedule.Count(x => !x.IsSent);
    var sentCount = Model.ReminderSchedule.Count(x => x.IsSent);
}

<style>
    .wa2-page {
        display: flex;
        flex-direction: column;
        gap: 18px
    }

    .wa2-hero {
        padding: 26px 28px;
        background: linear-gradient(115deg,#e1e8cc,#edf0de);
        border: 1px solid #c4cfad;
        border-radius: 16px;
        box-shadow: 0 3px 10px rgba(61,65,32,.04)
    }

    .wa2-eyebrow, .wa2-kicker {
        display: block;
        margin-bottom: 7px;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .07em;
        color: #59623e
    }

    .wa2-hero h1 {
        margin: 0 0 7px;
        color: #243c2b
    }

    .wa2-hero p {
        max-width: 820px;
        margin: 0;
        color: #52604f
    }

    .wa2-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px
    }

    .wa2-chip {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border: 1px solid #c5cfb6;
        border-radius: 999px;
        background: #ffffffa6;
        color: #44523f;
        font-size: .77rem;
        font-weight: 700
    }

    .wa2-panel {
        overflow: hidden;
        background: #fff;
        border: 1px solid #d1d5c4;
        border-radius: 14px;
        box-shadow: var(--surface-shadow,0 3px 12px rgba(36,51,30,.09))
    }

    .wa2-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 19px 22px;
        background: #f2f5ec;
        border-bottom: 1px solid #c6cfbe
    }

        .wa2-head h2 {
            margin: 0 0 4px;
            font-size: 1.16rem
        }

        .wa2-head p {
            margin: 0;
            font-size: .84rem;
            color: #667063
        }

    .wa2-count {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid #cad1c2;
        border-radius: 999px;
        background: #fff;
        color: #4e5a4c;
        font-size: .74rem;
        font-weight: 800
    }

    .wa2-schedule-note {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 22px;
        background: #fbfcf8;
        border-bottom: 1px solid #e2e5da;
        font-size: .78rem;
        color: #5f685b
    }

        .wa2-schedule-note strong {
            color: #314b38
        }

    .wa2-mini-stats {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

        .wa2-mini-stats span {
            padding: 4px 8px;
            border-radius: 999px;
            background: #eef2e7;
            border: 1px solid #d4dacb;
            font-size: .71rem;
            font-weight: 700
        }

    .wa2-reminder-table {
        width: 100%
    }

    .wa2-reminder-head, .wa2-reminder-row {
        display: grid;
        grid-template-columns: minmax(220px,1.5fr) minmax(115px,.62fr) minmax(125px,.65fr) minmax(155px,.75fr) minmax(135px,.66fr);
        gap: 15px;
        align-items: center
    }

    .wa2-reminder-head {
        padding: 11px 22px;
        background: #eceedd;
        border-bottom: 1px solid #c7cbb8;
        color: #40503e;
        font-size: .75rem;
        font-weight: 800
    }

    .wa2-reminder-row {
        padding: 15px 22px;
        border-bottom: 1px solid #e3e5dc
    }

        .wa2-reminder-row:last-child {
            border-bottom: 0
        }

    .wa2-customer {
        display: grid;
        grid-template-columns: 40px minmax(0,1fr);
        gap: 11px;
        align-items: center;
        min-width: 0
    }

    .wa2-avatar {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #e5eddb;
        color: #225c3d;
        font-weight: 800
    }

    .wa2-customer strong, .wa2-customer span, .wa2-cell strong, .wa2-cell span {
        display: block
    }

    .wa2-customer strong {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: .9rem;
        color: #173c2b
    }

    .wa2-customer span {
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: .72rem;
        color: #71796d
    }

    .wa2-cell span {
        font-size: .7rem;
        color: #777f73
    }

    .wa2-cell strong {
        margin-top: 2px;
        font-size: .86rem
    }

    .wa2-money strong {
        font-size: .96rem;
        font-variant-numeric: tabular-nums
    }

    .wa2-state {
        display: inline-flex;
        align-items: center;
        width: max-content;
        max-width: 100%;
        padding: 5px 8px;
        border: 1px solid #c9cec1;
        border-radius: 999px;
        background: #f5f6f1;
        color: #596158;
        font-size: .7rem;
        font-weight: 800
    }

        .wa2-state.is-sent {
            background: #e4edd8;
            border-color: #c2d4b3;
            color: #225c3d
        }

        .wa2-state.is-scheduled {
            background: #eef2e7;
            border-color: #d2dac8;
            color: #526246
        }

        .wa2-state.is-today {
            background: #fff5d9;
            border-color: #e4d4a2;
            color: #70501c
        }

        .wa2-state.is-problem {
            background: #fff0ec;
            border-color: #ecc5bc;
            color: #8f3027
        }

        .wa2-state.is-paused {
            background: #f1eee6;
            border-color: #d8d1c3;
            color: #6a6252
        }

    .wa2-status-detail {
        display: block;
        margin-top: 4px;
        font-size: .68rem;
        color: #777f73
    }

    .wa2-empty {
        padding: 30px 22px;
        text-align: center;
        color: #6f786b;
        font-size: .87rem
    }

    .wa2-utility-grid {
        display: grid;
        grid-template-columns: minmax(300px,.72fr) minmax(0,1.28fr);
        gap: 18px;
        align-items: stretch
    }

    .wa2-owner-body {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 0;
        padding: 5px 22px 10px
    }

    .wa2-owner-item {
        padding: 15px 0;
        border-bottom: 1px solid #e7e9e0
    }

        .wa2-owner-item:nth-last-child(-n+2) {
            border-bottom: 0
        }

        .wa2-owner-item:nth-child(odd) {
            padding-right: 18px
        }

        .wa2-owner-item:nth-child(even) {
            padding-left: 18px;
            border-left: 1px solid #e7e9e0
        }

        .wa2-owner-item span, .wa2-owner-item strong {
            display: block
        }

        .wa2-owner-item span {
            font-size: .72rem;
            color: #777f73
        }

        .wa2-owner-item strong {
            margin-top: 4px;
            font-size: .89rem;
            line-height: 1.45;
            overflow-wrap: anywhere
        }

    .wa2-owner-note {
        margin: 0 22px 20px;
        padding: 12px 13px;
        border: 1px solid #d7ddcf;
        border-radius: 10px;
        background: #f8faf5;
        color: #687265;
        font-size: .73rem;
        line-height: 1.5
    }

    .wa2-manual-wrap {
        padding: 18px 20px 20px
    }

    .wa2-customer-select {
        margin-bottom: 14px
    }

        .wa2-customer-select .form-label {
            margin-bottom: 7px;
            font-size: .8rem;
            font-weight: 800;
            color: #354435
        }

    .wa2-chat {
        overflow: hidden;
        border: 1px solid #c7d0c2;
        border-radius: 14px;
        background: #f7f8f4;
        box-shadow: 0 2px 8px rgba(32,64,43,.06)
    }

    .wa2-chat-top {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 14px;
        background: #23684c;
        color: #fff
    }

    .wa2-chat-avatar {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #dfe9db;
        color: #1c5e43;
        font-weight: 900;
        border: 2px solid rgba(255,255,255,.45)
    }

    .wa2-chat-person {
        min-width: 0
    }

        .wa2-chat-person strong, .wa2-chat-person span {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .wa2-chat-person strong {
            font-size: .93rem
        }

        .wa2-chat-person span {
            margin-top: 2px;
            font-size: .69rem;
            color: #dcebe3
        }

    .wa2-chat-mark {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .7rem;
        font-weight: 700;
        color: #e6f2ec
    }

        .wa2-chat-mark i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #bce0cc;
            box-shadow: 0 0 0 3px rgba(255,255,255,.09)
        }

    .wa2-chat-body {
        min-height: 190px;
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        padding: 22px 18px;
        background-color: #e9ede4;
        background-image: radial-gradient(circle at 18px 18px,rgba(58,89,67,.045) 1.3px,transparent 1.4px),radial-gradient(circle at 6px 6px,rgba(58,89,67,.03) 1px,transparent 1.1px);
        background-size: 28px 28px,22px 22px
    }

    .wa2-bubble {
        position: relative;
        max-width: min(82%,560px);
        padding: 11px 13px 19px;
        border-radius: 12px 12px 3px 12px;
        background: #dff2d4;
        border: 1px solid #c8dfbd;
        color: #26372b;
        font-size: .84rem;
        line-height: 1.5;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        box-shadow: 0 1px 2px rgba(35,68,48,.08)
    }

        .wa2-bubble.is-empty {
            color: #7b8479;
            background: #f4f6ef;
            border-color: #d9ddd3
        }

    .wa2-bubble-time {
        position: absolute;
        right: 9px;
        bottom: 5px;
        font-size: .6rem;
        color: #748072
    }

    .wa2-chat-compose {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 10px;
        align-items: end;
        padding: 12px;
        background: #f3f5f0;
        border-top: 1px solid #d5dbd0
    }

    .wa2-compose-box {
        position: relative
    }

        .wa2-compose-box textarea {
            min-height: 54px;
            max-height: 130px;
            resize: vertical;
            padding: 13px 14px;
            border-radius: 12px;
            background: #fff
        }

            .wa2-compose-box textarea:focus {
                border-color: #7fa38d;
                box-shadow: 0 0 0 .18rem rgba(34,99,72,.10)
            }

    .wa2-send-btn {
        min-width: 150px;
        min-height: 54px;
        border-radius: 12px
    }

    .wa2-chat-help {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 10px;
        color: #737d70;
        font-size: .71rem;
        line-height: 1.4
    }

        .wa2-chat-help span:first-child {
            width: 7px;
            height: 7px;
            flex: 0 0 7px;
            border-radius: 50%;
            background: #6c927c
        }

    .wa2-history-table {
        margin: 0
    }

        .wa2-history-table th {
            padding: .7rem .85rem;
            background: #eceedd;
            color: #40503e;
            font-size: .74rem
        }

        .wa2-history-table td {
            padding: .78rem .85rem;
            vertical-align: middle;
            font-size: .79rem
        }

            .wa2-history-table td strong, .wa2-history-table td small {
                display: block
            }

            .wa2-history-table td small {
                margin-top: 2px;
                color: #777f73;
                line-height: 1.35
            }

    .wa2-log {
        display: inline-flex;
        width: max-content;
        padding: 4px 8px;
        border: 1px solid #c9cec1;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 800
    }

    .wa2-log-sent {
        background: #e4edd8;
        color: #225c3d;
        border-color: #c2d4b3
    }

    .wa2-log-failed {
        background: #fff0ec;
        color: #8f3027;
        border-color: #ecc5bc
    }

    .wa2-log-pending {
        background: #fff7dd;
        color: #735119;
        border-color: #ead9a3
    }

    @@media(max-width:1180px) {
        .wa2-utility-grid {
            grid-template-columns: 1fr
        }

        .wa2-reminder-head, .wa2-reminder-row {
            grid-template-columns: minmax(200px,1.3fr) minmax(110px,.58fr) minmax(120px,.62fr) minmax(145px,.72fr) minmax(120px,.6fr)
        }
    }

    @@media(max-width:820px) {
        .wa2-reminder-head {
            display: none
        }

        .wa2-reminder-row {
            grid-template-columns: minmax(0,1fr) minmax(130px,.58fr);
            gap: 12px 16px;
            padding: 17px 18px
        }

        .wa2-customer {
            grid-column: 1/-1
        }

        .wa2-schedule-note {
            align-items: flex-start;
            flex-direction: column
        }

        .wa2-owner-body {
            grid-template-columns: 1fr
        }

        .wa2-owner-item:nth-child(n) {
            padding: 12px 0;
            border-left: 0;
            border-bottom: 1px solid #e7e9e0
        }

        .wa2-owner-item:last-child {
            border-bottom: 0
        }

        .wa2-history-table, .wa2-history-table tbody, .wa2-history-table tr, .wa2-history-table td {
            display: block;
            width: 100%
        }

            .wa2-history-table thead {
                display: none
            }

            .wa2-history-table tr {
                padding: 13px 18px;
                border-bottom: 1px solid #e2e5dc
            }

                .wa2-history-table tr:last-child {
                    border-bottom: 0
                }

            .wa2-history-table td {
                padding: 4px 0;
                border: 0
            }

                .wa2-history-table td:first-child {
                    padding-top: 0
                }

                .wa2-history-table td:last-child {
                    padding-bottom: 0;
                    color: #667063
                }
    }

    @@media(max-width:560px) {
        .wa2-page {
            gap: 14px
        }

        .wa2-hero {
            padding: 21px 19px
        }

        .wa2-head {
            align-items: flex-start;
            padding: 17px 18px
        }

        .wa2-count {
            display: none
        }

        .wa2-reminder-row {
            grid-template-columns: 1fr 1fr;
            gap: 13px
        }

        .wa2-customer {
            grid-column: 1/-1
        }

        .wa2-owner-body {
            padding-left: 18px;
            padding-right: 18px
        }

        .wa2-owner-note {
            margin-left: 18px;
            margin-right: 18px
        }

        .wa2-manual-wrap {
            padding: 15px 16px 17px
        }

        .wa2-chat-body {
            min-height: 170px;
            padding: 18px 13px
        }

        .wa2-bubble {
            max-width: 90%
        }

        .wa2-chat-compose {
            grid-template-columns: 1fr
        }

        .wa2-send-btn {
            width: 100%;
            min-height: 48px
        }
    }
</style>

<div class="wa2-page">
    <section class="wa2-hero">
        <span class="wa2-eyebrow">WHATSAPP / YAAD DEHANI</span>
        <h1>WhatsApp Messages</h1>
        <p>Customer due reminders, payment confirmation aur owner ki daily report ko ek simple jagah se manage karein.</p>
        <div class="wa2-hero-meta">
            <span class="wa2-chip">Owner report: Roz @ownerTime</span>
            <span class="wa2-chip">Due reminder: @options.DueReminderDaysBefore din pehle, @dueTime</span>
        </div>
    </section>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success mb-0" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger mb-0" role="alert">@error</div>
    }

    <section class="wa2-panel">
        <div class="wa2-head">
            <div>
                <span class="wa2-kicker">AUTOMATIC DUE REMINDERS</span>
                <h2>Customer Reminder Schedule</h2>
                <p>Kis customer ki due date kya hai aur reminder kis din automatically jayega, sab yahan clear nazar aayega.</p>
            </div>
            <span class="wa2-count">@Model.ReminderSchedule.Count due item(s)</span>
        </div>
        <div class="wa2-schedule-note">
            <div>Reminder <strong>due date se @options.DueReminderDaysBefore din pehle @dueTime</strong> par automatically send hoga.</div>
            <div class="wa2-mini-stats">
                <span>@waitingCount waiting</span>
                <span>@sentCount sent</span>
            </div>
        </div>

        @if (Model.ReminderSchedule.Count == 0)
        {
            <div class="wa2-empty">Abhi kisi open udhaar sale par due reminder schedule nahi hai.</div>
        }
        else
        {
            <div class="wa2-reminder-table">
                <div class="wa2-reminder-head" aria-hidden="true">
                    <div>Customer</div>
                    <div>Baqaya</div>
                    <div>Due Date</div>
                    <div>Message Jayega</div>
                    <div>Status</div>
                </div>

                @foreach (var item in Model.ReminderSchedule)
                {
                    var displayState = item.State == "Setup Required"
                    ? (item.MessageSendAt.Date >= BusinessTime.Today ? "Scheduled" : "Pending")
                    : item.State;
                    var stateClass = displayState switch
                    {
                        "Auto Sent" or "Sent" => "is-sent",
                        "Scheduled" => "is-scheduled",
                        "Aaj Send Hoga" or "Pending" => "is-today",
                        "Paused" => "is-paused",
                        _ => "is-problem"
                    };
                    <article class="wa2-reminder-row">
                        <div class="wa2-customer">
                            <div class="wa2-avatar">@((string.IsNullOrWhiteSpace(item.CustomerName) ? "C" : item.CustomerName[..1]).ToUpperInvariant())</div>
                            <div>
                                <strong>@item.CustomerName</strong>
                                <span>@item.Phone · @item.InvoiceReference</span>
                            </div>
                        </div>
                        <div class="wa2-cell wa2-money">
                            <span>Baqaya</span>
                            <strong>Rs. @item.Amount.ToString("N2")</strong>
                        </div>
                        <div class="wa2-cell">
                            <span>Due Date</span>
                            <strong>@item.DueDate.ToString("dd MMM yyyy")</strong>
                        </div>
                        <div class="wa2-cell">
                            <span>Automatic Message</span>
                            <strong>@item.MessageSendAt.ToString("dd MMM yyyy")</strong>
                            <span>@item.MessageSendAt.ToString("hh:mm tt")</span>
                        </div>
                        <div class="wa2-cell">
                            <span class="wa2-state @stateClass">@displayState</span>
                            @if (item.SentAt.HasValue)
                            {
                                <small class="wa2-status-detail">@item.SentAt.Value.ToString("dd MMM, hh:mm tt")</small>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.LastError) && displayState == "Failed")
                            {
                                <small class="wa2-status-detail text-danger">Send failed</small>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="wa2-utility-grid">
        <section class="wa2-panel">
            <div class="wa2-head">
                <div>
                    <span class="wa2-kicker">OWNER REPORT</span>
                    <h2>Daily Business Brief</h2>
                    <p>Roz raat owner ko short business report automatically jayegi.</p>
                </div>
                <span class="wa2-count">@(options.DailyOwnerReportEnabled ? "Automatic" : "Paused")</span>
            </div>
            <div class="wa2-owner-body">
                <div class="wa2-owner-item">
                    <span>Report Time</span>
                    <strong>Roz @ownerTime</strong>
                </div>
                <div class="wa2-owner-item">
                    <span>Delivery</span>
                    <strong>Owner ko WhatsApp par</strong>
                </div>
                <div class="wa2-owner-item">
                    <span>Report Mein</span>
                    <strong>Aaj ki sale, naya udhaar aur wasooli</strong>
                </div>
                <div class="wa2-owner-item">
                    <span>Summary</span>
                    <strong>Total customer baqaya bhi shamil hoga</strong>
                </div>
            </div>
            <p class="wa2-owner-note">Is report ke liye roz koi button press karne ki zarurat nahi hogi. System scheduled time par khud report bhejega.</p>
        </section>

        <section class="wa2-panel">
            <div class="wa2-head">
                <div>
                    <span class="wa2-kicker">MANUAL MESSAGE</span>
                    <h2>Customer Ko Message</h2>
                    <p>Kisi bhi customer ko zarurat ke mutabiq custom WhatsApp message bhejne ke liye.</p>
                </div>
            </div>

            <div class="wa2-manual-wrap">
                <div class="wa2-customer-select">
                    <label class="form-label" for="manualCustomer">Customer Select Karein</label>
                    <select id="manualCustomer" class="form-select" data-search data-search-label="Naam ya phone se customer search karein">
                        <option value="">Customer select karein</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id"
                                    data-phone="@WhatsAppCloudGateway.NormalizePhone(customer.Phone)"
                                    data-raw-phone="@customer.Phone"
                                    data-name="@customer.Name"
                                    data-business="@customer.BusinessName"
                                    data-detail="@customer.Phone · Baqaya Rs. @customer.Balance.ToString("N2")">
                                @customer.Name - @customer.Phone - @customer.BusinessName
                            </option>
                        }
                    </select>
                </div>

                <div class="wa2-chat">
                    <div class="wa2-chat-top">
                        <div id="chatAvatar" class="wa2-chat-avatar">C</div>
                        <div class="wa2-chat-person">
                            <strong id="chatCustomerName">Customer select karein</strong>
                            <span id="chatCustomerMeta">Naam ya phone se customer choose karein</span>
                        </div>
                        <div class="wa2-chat-mark"><i></i><span>WhatsApp</span></div>
                    </div>

                    <div class="wa2-chat-body">
                        <div id="chatPreview" class="wa2-bubble is-empty">
                            <span id="chatPreviewText">Aap ka message yahan preview hoga.</span>
                            <small class="wa2-bubble-time">abhi</small>
                        </div>
                    </div>

                    <div class="wa2-chat-compose">
                        <div class="wa2-compose-box">
                            <textarea id="manualMessage" class="form-control" rows="2" placeholder="Message likhein..."></textarea>
                        </div>
                        <button type="button" id="openWhatsApp" class="btn btn-primary wa2-send-btn">WhatsApp Kholein</button>
                    </div>
                </div>

                <div class="wa2-chat-help"><span></span><span>Customer aur message select karne ke baad WhatsApp khulega; final Send WhatsApp mein press hoga.</span></div>
            </div>
        </section>
    </div>

    <section class="wa2-panel">
        <div class="wa2-head">
            <div>
                <span class="wa2-kicker">RECENT ACTIVITY</span>
                <h2>Recent WhatsApp Status</h2>
                <p>Recent automatic aur optional messages ka send/fail record.</p>
            </div>
            <span class="wa2-count">Last @Model.RecentLogs.Count</span>
        </div>

        @if (Model.RecentLogs.Count == 0)
        {
            <div class="wa2-empty">Abhi koi WhatsApp activity nahi hai.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table wa2-history-table align-middle">
                    <thead>
                        <tr>
                            <th>Message</th>
                            <th>Customer / Number</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.RecentLogs)
                        {
                            var label = log.Kind switch
                            {
                                WhatsAppMessageKind.OwnerDailyReport => "Owner Daily Report",
                                WhatsAppMessageKind.DueReminder => "Due Reminder",
                                WhatsAppMessageKind.PaymentReceived => "Payment Received",
                                _ => "WhatsApp Message"
                            };
                            <tr>
                                <td>
                                    <strong>@label</strong>
                                    <small>@log.MessagePreview</small>
                                </td>
                                <td>
                                    <strong>@(log.Customer?.Name ?? (log.Kind == WhatsAppMessageKind.OwnerDailyReport ? "Owner" : "—"))</strong>
                                    <small>@log.Recipient</small>
                                </td>
                                <td>
                                    <span class="wa2-log wa2-log-@log.Status.ToString().ToLowerInvariant()">@log.Status</span>
                                    <small>@(log.IsAutomatic ? "Automatic" : "Manual / Optional")</small>
                                </td>
                                <td>@BusinessTime.ToLocal(log.CreatedAt).ToString("dd MMM, hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const customer = document.getElementById('manualCustomer');
            const message = document.getElementById('manualMessage');
            const button = document.getElementById('openWhatsApp');
            const headerName = document.getElementById('chatCustomerName');
            const headerMeta = document.getElementById('chatCustomerMeta');
            const avatar = document.getElementById('chatAvatar');
            const preview = document.getElementById('chatPreview');
            const previewText = document.getElementById('chatPreviewText');
            if (!customer || !message || !button || !headerName || !headerMeta || !avatar || !preview || !previewText) return;

            let lastAutoGreeting = '';

            const updatePreview = () => {
                const text = message.value.trim();
                previewText.textContent = text || 'Aap ka message yahan preview hoga.';
                preview.classList.toggle('is-empty', !text);
            };

            const updateCustomer = () => {
                const option = customer.selectedOptions[0];
                if (!option?.value) {
                    headerName.textContent = 'Customer select karein';
                    headerMeta.textContent = 'Naam ya phone se customer choose karein';
                    avatar.textContent = 'C';
                    if (message.value.trim() === lastAutoGreeting) message.value = '';
                    lastAutoGreeting = '';
                    updatePreview();
                    return;
                }

                const name = option.dataset.name || 'Customer';
                const rawPhone = option.dataset.rawPhone || '';
                const business = option.dataset.business || '';
                headerName.textContent = name;
                headerMeta.textContent = [rawPhone, business].filter(Boolean).join(' · ') || 'WhatsApp customer';
                avatar.textContent = (name.trim().charAt(0) || 'C').toUpperCase();

                const newGreeting = `Assalam-o-Alaikum ${name}, `;
                const current = message.value.trim();
                if (!current || current === lastAutoGreeting.trim()) {
                    message.value = newGreeting;
                }
                lastAutoGreeting = newGreeting;
                updatePreview();
            };

            customer.addEventListener('change', updateCustomer);
            message.addEventListener('input', updatePreview);

            button.addEventListener('click', () => {
                const option = customer.selectedOptions[0];
                const phone = option?.dataset.phone || '';
                const text = message.value.trim();
                if (!phone) { customer._search?.input?.focus?.(); customer.focus(); return; }
                if (!text) { message.focus(); return; }
                window.open(`https://wa.me/${phone}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
            });

            updateCustomer();
        })();
    </script>
}
