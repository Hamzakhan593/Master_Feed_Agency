@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var pageTitle = ViewData["Title"]?.ToString();
    var userName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName[0].ToString().ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = "Master Feed Agency";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#226348" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Master Feed" />
    <meta name="application-name" content="Master Feed Agency" />
    <meta name="description" content="Master Feed Agency sales, customer khata, udhaar and stock management." />
    <title>@pageTitle - Master Feed Agency</title>
    <script type="importmap"></script>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/icons/brand.svg" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body @(isAuthenticated ? "app-authenticated" : "app-public")">
    <a class="app-skip-link" href="#mainContent">Skip to main content</a>
    <div id="networkStatus" class="offline-banner d-none" role="status" aria-live="polite">
        <span class="offline-dot" aria-hidden="true"></span>
        Connection lost. Reconnect before saving a sale or payment.
    </div>

    @if (isAuthenticated)
    {
        <div class="app-shell">
            <aside class="app-sidebar d-none d-lg-flex">
                <div class="app-sidebar-brand">
                    <a class="app-brand" asp-page="/Index" aria-label="Master Feed Agency home">
                        <span class="app-brand-mark">MF</span>
                        <span class="app-brand-copy">
                            <strong>Master Feed</strong>
                            <small>Agency Management</small>
                        </span>
                    </a>
                </div>

                <div class="app-sidebar-scroll">
                    <partial name="_AppNavigation" />
                </div>

                <div class="app-sidebar-footer">
                    <div class="app-sidebar-footer-label">Master Feed Agency</div>
                    <div>Sales · Payments · Stock</div>
                </div>
            </aside>

            <div class="app-workspace">
                <header class="app-topbar">
                    <div class="app-topbar-left">
                        <button class="app-menu-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-label="Open navigation">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                        </button>
                        <div class="app-page-heading">
                            <span class="app-page-kicker">Rozana Kaam</span>
                            <span class="app-page-title">@pageTitle</span>
                        </div>
                    </div>

                    <div class="app-topbar-actions">
                        <button type="button" class="btn btn-light app-install-button d-none" data-pwa-install>
                            Install App
                        </button>

                        @if (User.HasPermission(AppPermissions.CreateSales))
                        {
                            <a asp-page="/Sales/Create" class="btn btn-primary d-none d-md-inline-flex app-top-action">Nayi Sale</a>
                        }

                        <div class="dropdown">
                            <button class="app-user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="app-user-avatar">@userInitial</span>
                                <span class="app-user-copy d-none d-sm-flex">
                                    <strong>@userName</strong>
                                    <small>Signed in</small>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end app-user-menu shadow-sm">
                                <li class="px-3 pt-2 pb-1">
                                    <div class="small text-muted">Account</div>
                                    <div class="fw-semibold text-truncate app-user-menu-name">@userName</div>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-page="/Account/ChangePassword">Change password</a></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger">Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <main id="mainContent" class="app-content" role="main" tabindex="-1">
                    <div class="app-content-inner">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>

        <div class="offcanvas offcanvas-start app-mobile-drawer d-lg-none" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
            <div class="offcanvas-header app-mobile-drawer-header">
                <a class="app-brand app-brand-mobile" asp-page="/Index">
                    <span class="app-brand-mark">MF</span>
                    <span class="app-brand-copy">
                        <strong id="mobileMenuLabel">Master Feed</strong>
                        <small>Agency Management</small>
                    </span>
                </a>
                <button type="button" class="btn-close " data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body app-mobile-drawer-body">
                <partial name="_AppNavigation" />
            </div>
            <div class="app-mobile-drawer-footer">
                <button type="button" class="btn btn-outline-secondary w-100 mb-2 d-none" data-pwa-install>Install on this device</button>
                <a asp-page="/Account/ChangePassword" class="btn btn-dark-subtle w-100 mb-2" data-mobile-nav-close>Change Password</a>
                <form method="post" asp-page="/Account/Logout" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary w-100">Sign out</button>
                </form>
            </div>
        </div>

        <nav class="mobile-bottom-nav d-lg-none" aria-label="Quick actions">
            @if (User.HasPermission(AppPermissions.ViewDashboard))
            {
                <a asp-page="/Dashboard/Index" class="mobile-bottom-link" data-nav-path="/Dashboard">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v10h-6zM4 14h6v6H4zM14 18h6v2h-6z" /></svg>
                    <span>Home</span>
                </a>
            }
            @if (User.HasPermission(AppPermissions.CreateSales))
            {
                <a asp-page="/Sales/Create" class="mobile-bottom-link" data-nav-path="/Sales">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    <span>Nayi Sale</span>
                </a>
            }
            @if (User.HasPermission(AppPermissions.ReceivePayments))
            {
                <a asp-page="/Payments/Create" class="mobile-bottom-link" data-nav-path="/Payments">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M8 15h3" /></svg>
                    <span>Wasooli</span>
                </a>
            }
            @if (User.HasPermission(AppPermissions.ViewCustomers))
            {
                <a asp-page="/Customers/Index" class="mobile-bottom-link" data-nav-path="/Customers">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 20v-1.5A3.5 3.5 0 0 0 12.5 15h-5A3.5 3.5 0 0 0 4 18.5V20M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8" /></svg>
                    <span>Customers</span>
                </a>
            }
            <button type="button" class="mobile-bottom-link mobile-bottom-button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                <span>Menu</span>
            </button>
        </nav>
        <button type="button" class="app-scroll-top" data-scroll-top aria-label="Back to top" title="Back to top">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
        </button>
    }
    else
    {
        <header class="public-header">
            <div class="container-xl d-flex align-items-center justify-content-between gap-3">
                <a class="app-brand app-brand-public" asp-page="/Index">
                    <span class="app-brand-mark">MF</span>
                    <span class="app-brand-copy">
                        <strong>Master Feed</strong>
                        <small>Agency Management</small>
                    </span>
                </a>
                <a asp-page="/Account/Login" class="btn btn-primary">Sign in</a>
            </div>
        </header>

        <main id="mainContent" class="public-main" role="main" tabindex="-1">
            <div class="container-xl">
                @RenderBody()
            </div>
        </main>

        <footer class="public-footer">
            <div class="container-xl small">&copy; 2026 Master Feed Agency Management System</div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/easy-entry.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
