@page
@model Master_Feed_Agency.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Product Add Karein";
}

<div class="product-page product-form-page">
    <section class="product-page-header product-form-header">
        <div class="product-page-heading">
            <span class="product-page-kicker">Naya Product</span>
            <h1>Product Add Karein</h1>
            <p>Product ka naam, rate aur maujooda stock darj karein.</p>
        </div>
        <div class="product-page-actions">
            <a data-return-list="/Products" asp-page="Index" class="btn btn-light product-header-btn">Products Par Wapas</a>
        </div>
    </section>

    <div class="product-form-layout">
        <main class="product-form-main">
            <section class="product-form-panel">
                <div class="product-form-panel-head">
                    <span class="product-form-step">1</span>
                    <div><h2>Product Ki Maloomat</h2><p>Yeh maloomat sale aur stock record mein nazar aayegi.</p></div>
                </div>
                <form method="post" id="productCreateForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger product-validation-summary"></div>
                    <div class="product-form-panel-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Input.Code" class="product-field-label"></label>
                                <input asp-for="Input.Code" class="form-control product-control text-uppercase" placeholder="e.g. MF-001" />
                                <span asp-validation-for="Input.Code" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Input.Name" class="product-field-label"></label>
                                <input asp-for="Input.Name" class="form-control product-control" placeholder="e.g. Broiler Feed Premium" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.Unit" class="product-field-label"></label>
                                <input asp-for="Input.Unit" class="form-control product-control" placeholder="Bag" />
                                <span asp-validation-for="Input.Unit" class="text-danger small"></span>
                                <div class="product-field-hint">Unit likhein, jaise Bag ya Kg.</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.PurchaseCost" class="product-field-label"></label>
                                <div class="input-group product-money-input"><span class="input-group-text">Rs.</span><input asp-for="Input.PurchaseCost" class="form-control" placeholder="0.00" /></div>
                                <span asp-validation-for="Input.PurchaseCost" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.DefaultSalePrice" class="product-field-label"></label>
                                <div class="input-group product-money-input"><span class="input-group-text">Rs.</span><input asp-for="Input.DefaultSalePrice" class="form-control" placeholder="0.00" /></div>
                                <span asp-validation-for="Input.DefaultSalePrice" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="product-form-panel-head product-form-subhead">
                        <span class="product-form-step is-green">2</span>
                        <div><h2>Shuru Ka Stock</h2><p>Maujooda quantity aur kam stock ki limit darj karein.</p></div>
                    </div>
                    <div class="product-form-panel-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.OpeningStock" class="product-field-label"></label>
                                <div class="product-quantity-control">
                                    <input asp-for="Input.OpeningStock" class="form-control product-control" placeholder="0" />
                                    <span>Maujooda Quantity</span>
                                </div>
                                <span asp-validation-for="Input.OpeningStock" class="text-danger small"></span>
                                <div class="product-field-hint">Stock gin kar maujooda quantity likhein.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.LowStockThreshold" class="product-field-label"></label>
                                <div class="product-quantity-control is-warning">
                                    <input asp-for="Input.LowStockThreshold" class="form-control product-control" placeholder="0" />
                                    <span>Kam Stock Ki Limit</span>
                                </div>
                                <span asp-validation-for="Input.LowStockThreshold" class="text-danger small"></span>
                                <div class="product-field-hint">Stock is limit tak ya is se kam hone par Kam Stock dikhaya jayega.</div>
                            </div>
                        </div>
                    </div>

                    <div class="product-form-footer">
                        <div class="product-integrity-note">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="m9 12 2 2 4-4" /></svg>
                            <div><strong>Shuru Ka Stock</strong><span>Shuru ka stock record mein save hoga. Baad mein stock badalne ke liye Stock Add / Correct Karein use karein.</span></div>
                        </div>
                        <div class="product-form-actions">
                            <a data-return-list="/Products" asp-page="Index" class="btn btn-light">Wapas Jayein</a>
                            <button type="submit" class="btn btn-primary">Product Save Karein</button>
                        </div>
                    </div>
                </form>
            </section>
        </main>

        <aside class="product-form-side">
            <section class="product-side-card">
                <div class="product-side-card-title">Save Karne Se Pehle</div>
                <div class="product-side-card-body">
                    <div class="product-check-row"><span>1</span><div><strong>Alag Product Code Rakhein</strong><small>Chhota code rakhein taake bill aur search mein asani ho.</small></div></div>
                    <div class="product-check-row"><span>2</span><div><strong>Sale Rate Check Karein</strong><small>Nayi sale mein yahi rate pehle se nazar aayega.</small></div></div>
                    <div class="product-check-row"><span>3</span><div><strong>Stock Gin Lein</strong><small>Shuru ka stock aapki maujooda quantity ke barabar hona chahiye.</small></div></div>
                    <div class="product-check-row"><span>4</span><div><strong>Kam Stock Ki Limit Rakhein</strong><small>Aisi limit rakhein ke stock khatam hone se pehle mangwa sakein.</small></div></div>
                </div>
            </section>
            <section class="product-side-card product-side-card-soft">
                <div class="product-side-card-title">Save Karne Ke Baad</div>
                <div class="product-side-card-body product-side-copy">
                    <p>Product nayi sale mein select ho sakega. Shuru ki quantity Stock Record mein nazar aayegi.</p>
                    <a data-return-list="/Products" asp-page="Index">Products / Stock Dekhein</a>
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
