@page "{id}"
@model Master_Feed_Agency.Pages.Admin.Users.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    var initial = string.IsNullOrWhiteSpace(Model.TargetUserName) ? "U" : Model.TargetUserName[..1].ToUpperInvariant();
}

<div class="usrx-page usrx-form-page">
    <section class="usrx-compact-hero">
        <div>
            <a asp-page="Index" class="usrx-back-link">← Staff / Access</a>
            <div class="usrx-eyebrow">Administration · Security</div>
            <h1>Reset password</h1>
            <p>Issue a temporary password and require a secure change at the user's next sign-in.</p>
        </div>
    </section>

    <div class="usrx-reset-grid">
        <section class="usrx-form-card">
            <header class="usrx-profile-head">
                <div class="usrx-avatar usrx-avatar-lg">@initial</div>
                <div><span>Password reset for</span><h2>@Model.TargetUserName</h2><p>Temporary credential workflow</p></div>
            </header>

            <form method="post">
                <input type="hidden" asp-for="Input.UserId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger usrx-validation"></div>

                <div class="usrx-field-grid usrx-field-grid-one">
                    <div class="usrx-field">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Enter temporary password" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="usrx-field">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat temporary password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="usrx-force-change">
                    <span>1</span>
                    <div><strong>Temporary password is applied</strong><small>The current password is replaced securely.</small></div>
                    <span>2</span>
                    <div><strong>User signs in</strong><small>The user is marked to change the temporary password.</small></div>
                    <span>3</span>
                    <div><strong>New private password</strong><small>The user chooses their own password after sign-in.</small></div>
                </div>

                <div class="usrx-form-actions">
                    <a asp-page="Index" class="btn btn-outline-secondary">Wapas Jayein</a>
                    <button type="submit" class="btn btn-warning usrx-reset-btn">Reset Password</button>
                </div>
            </form>
        </section>

        <aside class="usrx-side-card usrx-side-card-warning">
            <div class="usrx-side-label">Security action</div>
            <h3>Use only when necessary</h3>
            <p>Temporary password staff member ko dein. Agli login par woh naya password set karega.</p>
            <div class="usrx-security-points">
                <span>✓ User must change temporary password</span>
                <span>✓ Security stamp is refreshed</span>
                <span>✓ Agli login par naya password zaroori hai</span>
            </div>
        </aside>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
